# ==============================================
# 案件7 RAGナレッジ検索 + Slackボット 環境変数サンプル
# ----------------------------------------------
# このファイルは Git にコミットする（キー名のみ共有）。
# 実際の値は .env に記載し、.env は絶対にコミットしない。
# 参照：requirements.md §33 環境変数一覧
# ==============================================

# --- Supabase ---
# プロジェクトURL（Supabaseダッシュボード → Project Settings → API）
SUPABASE_URL=

# クライアント側（ブラウザ）で使用する公開キー
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側（Route Handler / API）でのみ使用する service_role キー
# 漏洩すると全データアクセス可能になるため、絶対にクライアント側に露出させない
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM ---
# 使用するプロバイダ切替（gemini | claude）。本番切替はこの変数のみで完結
LLM_PROVIDER=gemini

# Gemini API（LLM + Embedding 兼用）
GEMINI_API_KEY=

# Claude API（本番切替時に使用）
ANTHROPIC_API_KEY=

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- アプリ設定 ---
# Slack 30秒タイムアウト時の誘導先URL
WEB_APP_URL=http://localhost:3000

# ログ・監査ログのデフォルト保存日数（DB設定値が優先）
LOG_RETENTION_DAYS=30

# アップロード上限（MB）。要件§2 の本番基準は 20MB。
# G-1 で Storage 直接アップロードに移行済みのため、ローカル・Vercel ともにデフォルト 20 のまま使用する。
MAX_FILE_SIZE_MB=20

# Slack Web 誘導タイムアウト（ms）。デフォルト 30000（30秒）。有効範囲: 1000〜30000。範囲外は 30000 にフォールバック
# SLACK_FALLBACK_MS=30000

# --- Storage 直接アップロード（段階1） ---
# Supabase Storage バケット名（デフォルト: rag-documents）
SUPABASE_STORAGE_BUCKET=rag-documents

# GitHub Actions workflow_dispatch 起動用トークン（段階2で使用）
# fine-grained: リポジトリ限定・Actions write のみ。値は絶対にコミットしない
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=usako-ui/consulting-rag-knowledge-system-dev

# --- 検証用アカウント（開発・テスト専用・本番運用では使用しない） ---
# scripts/eval-recall.ts, setup-test-users.ts, test-admin-users-e2e.sh が参照する。
# 平文の値は .env にのみ記入し、.env.example にはキー名だけ列挙する（git コミット対象外）。
EVAL_ADMIN_EMAIL=eval-admin@case7.local
EVAL_ADMIN_PASSWORD=
EVAL_HR_EMAIL=eval-hr@case7.local
EVAL_HR_PASSWORD=
